<?xml version="1.0" encoding="utf-8"?>
<!-- Central Package Management requires an unambiguous source list: clear inherited
     machine/user sources (e.g. local mirrors) and pin the solution to nuget.org only,
     so restores are deterministic on dev machines and CI (NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
