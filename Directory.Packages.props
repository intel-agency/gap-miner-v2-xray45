<Project>
  <!-- Central Package Management: every NuGet version for the GapMiner solution
       is declared here (plan §3 Technology Stack — Exact Versions, Do Not Deviate).
       Projects reference packages without Version attributes. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Orchestration: .NET Aspire 8.2.x (AppHost meta-package required by the aspire
         workload SDK targets; pulls Aspire.Hosting transitively at the same version). -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="8.2.2" />
    <PackageVersion Include="Aspire.Hosting" Version="8.2.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="8.2.2" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="8.2.2" />

    <!-- ORM: Entity Framework Core 8.0.x + PostgreSQL 16.x + pgvector 0.7.x -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.10" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.2.0" />

    <!-- Queue / Cache: Redis 7.x (StackExchange.Redis client) -->
    <PackageVersion Include="StackExchange.Redis" Version="2.13.23" />

    <!-- Job Scheduling: Hangfire 1.8.x -->
    <PackageVersion Include="Hangfire.Core" Version="1.8.14" />

    <!-- AI Orchestration: Semantic Kernel 1.20.x -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.20.0" />

    <!-- HTTP Client: Refit 7.x -->
    <PackageVersion Include="Refit.HttpClientFactory" Version="7.2.1" />

    <!-- Validation: FluentValidation 11.x -->
    <PackageVersion Include="FluentValidation" Version="11.10.0" />

    <!-- Testing: xUnit + NSubstitute + Testcontainers (latest stable) -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.16.0" />

    <!-- Code Quality: SonarAnalyzer.CSharp + StyleCop.Analyzers (latest stable) -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>
</Project>
