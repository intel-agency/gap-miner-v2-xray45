<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Story 3.3 (T-2.3): the scraping background worker. Hangfire drives the
       ScrapeReviewsJob (registered as the recurring scrape-reviews job that
       dequeues ScrapeTargetCommands from the Redis scrape queue); the web host
       stays so the ServiceDefaults endpoints (/health, /alive) remain served
       (Story 1.3), and the Hangfire dashboard is exposed at /hangfire. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Job scheduler: DI/server/dashboard integration + Redis storage at the
         plan's Hangfire 1.8.x pin (versions centrally in Directory.Packages.props). -->
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.Redis.StackExchange" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GapMiner.ServiceDefaults\GapMiner.ServiceDefaults.csproj" />
    <ProjectReference Include="..\GapMiner.Infrastructure\GapMiner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
