<Project Sdk="Microsoft.NET.Sdk">

  <!-- Story 2.2 (T-1.2): EF Core persistence for the GapMiner domain model.
       Versions are pinned centrally in Directory.Packages.props (plan §3):
       Npgsql.EntityFrameworkCore.PostgreSQL 8.0.10 + Pgvector.EntityFrameworkCore 0.2.0
       on EF Core 8.0.x. Design is a private design-time dependency used by the
       repo-local dotnet-ef tool (.config/dotnet-tools.json) to generate migrations. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Story 4.1 (T-3.1): SK 1.20.0 (the plan §3 pin) marks the embedding
         DI extensions (SKEXP0010) and ITextEmbeddingGenerationService
         (SKEXP0001) as "experimental / subject to change". Version drift is
         governed by the plan's exact pin, not by avoiding the API, so both
         diagnostics are suppressed with this rationale rather than bumping
         SK or hand-rolling the registration path. -->
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct EF references (CPM-pinned 8.0.34) so the exact EF versions flow to
         consumers; Npgsql 8.0.10's transitive pins alone would leave them on 8.0.10
         while Design (PrivateAssets) compiles this assembly against 8.0.34. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Story 2.4 (T-1.4): Redis-backed job queue client (CPM-pinned 2.13.23,
         plan §3 "Queue / Cache"). -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 3.1 (T-2.1): typed Apify v2 REST client. Refit 7.2.1 is the
         plan §3 "HTTP Client" pin; the Polly retry pipeline comes from
         Microsoft.Extensions.Http.Resilience (Polly v8) — the resilience
         package Story 1.3 already pinned with the ServiceDefaults template
         set, so no new transitive stack is introduced. -->
    <PackageReference Include="Refit.HttpClientFactory" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 4.1 (T-3.1): Semantic Kernel bootstrap. Microsoft.SemanticKernel
         1.20.0 is the plan §3 pin (meta package = Core + the AzureOpenAI
         connector, whose OpenAI connector flows in transitively for the
         Anthropic branch's OpenAI embeddings). Anthropic.SDK 5.10.0 is the
         community Anthropic client the Claude chat branch adapts (see
         SemanticKernelBuilderExtensions remarks): verified live 2026-11-21
         that no SK-1.20-compatible package connector exists. -->
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Anthropic.SDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GapMiner.Domain\GapMiner.Domain.csproj" />
  </ItemGroup>

</Project>
